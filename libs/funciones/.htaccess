DirectoryIndex index.php
AddDefaultCharset utf-8

RewriteEngine on
Options +FollowSymlinks -MultiViews -Indexes   

RewriteBase /

# No mostrar el contenido
IndexIgnore *

# asegurar .htaccess
<Files .htaccess>
 order allow,deny
 deny from all
</Files>

# bloquear doble extension 
<FilesMatch ".*\\.([^.]+)\\.([^.]+)$">
Order Deny,Allow
Deny from all
</FilesMatch>

ErrorDocument 403 /error/403.html